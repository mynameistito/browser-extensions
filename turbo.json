{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "!.output/**/*.map"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "//#typecheck:root"],
      "outputs": []
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "//#test:root": {
      "outputs": []
    }
  }
}
