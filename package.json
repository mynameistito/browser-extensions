{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "new-tab-ext",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "mynameistito",
    "email": "github@mynameistito.com",
    "url": "https://github.com/mynameistito"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/new-tab-ext.git"
  },
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "bunx knip@latest",
    "changeset": "changeset",
    "changeset-add": "bun ./scripts/changeset-add.ts",
    "generate-key": "bun scripts/generate-key.ts",
    "version": "changeset version && wxt prepare",
    "prepare": "lefthook install",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.15",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.2",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
