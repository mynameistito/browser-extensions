{
  "name": "better-history",
  "version": "8.0.6",
  "private": true,
  "description": "Powerful browser history search, filtering, and cleanup for Chrome and Firefox.",
  "keywords": [
    "browser-extension",
    "history",
    "privacy",
    "search",
    "wxt"
  ],
  "homepage": "https://github.com/mynameistito/browser-extensions/tree/main/apps/better-history",
  "bugs": {
    "url": "https://github.com/mynameistito/browser-extensions/issues"
  },
  "license": "MIT",
  "author": "My Name is Tito <github@mynameistito.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/browser-extensions.git",
    "directory": "apps/better-history"
  },
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "ci:release": "bun ../../scripts/release-app.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "dev": "bun ../../scripts/run-wxt.ts",
    "dev:firefox": "bun ../../scripts/run-wxt.ts -b firefox",
    "build": "bun ../../scripts/run-wxt.ts build && bun ../../scripts/run-wxt.ts build -b firefox",
    "build:chrome": "bun ../../scripts/run-wxt.ts build",
    "build:firefox": "bun ../../scripts/run-wxt.ts build -b firefox",
    "zip": "bun ../../scripts/run-wxt.ts zip && bun ../../scripts/run-wxt.ts zip -b firefox",
    "zip:all": "bun run zip",
    "zip:chrome": "bun ../../scripts/run-wxt.ts zip -b chrome",
    "zip:firefox": "bun ../../scripts/run-wxt.ts zip -b firefox",
    "postinstall": "bun ../../scripts/run-wxt.ts prepare"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "better-result": "^3.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "catalog:",
    "virtua": "^0.53.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "vitest": "catalog:",
    "wxt": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
