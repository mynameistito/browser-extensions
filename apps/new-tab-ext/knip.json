{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/entrypoints/**/*.{ts,tsx}",
    "scripts/*.ts",
    "oxlint.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", "*.config.ts"],
  "ignoreBinaries": ["tsc", "ultracite"],
  "ignoreDependencies": ["oxlint", "ultracite"]
}
