{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "new-tab-ext",
  "version": "0.2.5",
  "private": true,
  "description": "A local-first browser new-tab dashboard built with WXT, React, and Effect.",
  "keywords": [
    "browser-extension",
    "dashboard",
    "local-first",
    "new-tab",
    "wxt"
  ],
  "homepage": "https://github.com/mynameistito/browser-extensions/tree/main/apps/new-tab-ext",
  "bugs": {
    "url": "https://github.com/mynameistito/browser-extensions/issues"
  },
  "license": "MIT",
  "author": {
    "name": "mynameistito",
    "email": "github@mynameistito.com",
    "url": "https://github.com/mynameistito"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/browser-extensions.git",
    "directory": "apps/new-tab-ext"
  },
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "changeset-add": "bun scripts/changeset-add.ts",
    "fix": "ultracite fix",
    "ci:release": "bun ../../scripts/release-app.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-cache --coverage",
    "test:coverage": "vitest run --no-cache --coverage",
    "knip": "bunx knip@latest",
    "dev": "bun ../../scripts/run-wxt.ts",
    "dev:firefox": "bun ../../scripts/run-wxt.ts -b firefox",
    "build": "bun ../../scripts/run-wxt.ts build && bun ../../scripts/run-wxt.ts build -b firefox",
    "build:chrome": "bun ../../scripts/run-wxt.ts build",
    "build:firefox": "bun ../../scripts/run-wxt.ts build -b firefox",
    "zip": "bun ../../scripts/run-wxt.ts zip && bun ../../scripts/run-wxt.ts zip -b firefox",
    "zip:all": "bun run zip",
    "zip:chrome": "bun ../../scripts/run-wxt.ts zip -b chrome",
    "zip:firefox": "bun ../../scripts/run-wxt.ts zip -b firefox",
    "postinstall": "bun ../../scripts/run-wxt.ts prepare"
  },
  "dependencies": {
    "effect": "^4.0.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "catalog:",
    "react-grab": "^0.2.0",
    "tailwindcss": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:",
    "web-ext": "^10.8.0",
    "wxt": "catalog:"
  }
}
