{
  "name": "hide-email-ext",
  "version": "0.3.3",
  "private": true,
  "description": "A cross-browser extension that redacts selected email addresses from web pages.",
  "keywords": [
    "browser-extension",
    "email-privacy",
    "redaction",
    "wxt"
  ],
  "homepage": "https://github.com/mynameistito/browser-extensions/tree/main/apps/hide-email-ext",
  "bugs": {
    "url": "https://github.com/mynameistito/browser-extensions/issues"
  },
  "license": "MIT",
  "author": "My Name is Tito <github@mynameistito.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/browser-extensions.git",
    "directory": "apps/hide-email-ext"
  },
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/run-wxt.ts",
    "dev:firefox": "bun ../../scripts/run-wxt.ts -b firefox",
    "build": "bun ../../scripts/run-wxt.ts build && bun ../../scripts/run-wxt.ts build -b firefox",
    "build:firefox": "bun ../../scripts/run-wxt.ts build -b firefox",
    "zip": "bun ../../scripts/run-wxt.ts zip",
    "zip:chrome": "bun ../../scripts/run-wxt.ts zip -b chrome",
    "zip:firefox": "bun ../../scripts/run-wxt.ts zip -b firefox",
    "zip:all": "bun run zip:chrome && bun run zip:firefox",
    "postinstall": "bun ../../scripts/run-wxt.ts prepare",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "ci:release": "bun ../../scripts/release-app.ts",
    "knip": "bunx knip@latest"
  },
  "devDependencies": {
    "@types/chrome": "catalog:",
    "happy-dom": "catalog:",
    "vitest": "catalog:",
    "wxt": "catalog:"
  }
}
